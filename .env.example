# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinical_notes

# Data directories
DATA_DIR=./data

# MIMIC-IV source for evaluation: demo or full
MIMIC_SOURCE=demo
# Root of the MIMIC-IV clinical database demo (contains hosp/)
MIMIC_DEMO_ROOT=/Users/you/Downloads/mimic-iv-clinical-database-demo-2.2
# Root of the full MIMIC-IV 3.1 download (contains hosp/ and icu/)
MIMIC_FULL_ROOT=/Users/you/physionet.org/files/mimiciv/3.1

# Spark
SPARK_HOME=/opt/spark
SPARK_MASTER=local[*]
